# External Railway Telemetry & Live Tracking
RAILRADAR_API_KEY=

# Weather Intelligence API
OPENWEATHER_API_KEY=

# Simulation & Demo Fallback Mode (true = high-fidelity real-time physics simulation & offline fallback)
DEMO_MODE=true

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/railrakshak

# AI Engine Settings
AI_MODEL_NAME=RailRakshak-ResNet50-Rail
AI_MODEL_VERSION=v2.4.0
